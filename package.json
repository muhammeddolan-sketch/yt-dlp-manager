{
  "name": "yt-dlp-manager",
  "version": "1.7.0",
  "description": "Premium YT-DLP GUI Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "test": "node --check server.js && node --check main.js && node --check preload.js && node --check public/app.js && node --check public/uniget-extension.user.js && node --check web-extension/background.js && node --check web-extension/content.js && node tests/api-smoke.test.js",
    "pack:extension": "node scripts/pack-extensions.js chrome",
    "pack:extension:firefox": "node scripts/pack-extensions.js firefox",
    "pack:extension:all": "node scripts/pack-extensions.js"
  },
  "build": {
    "appId": "com.uniget.app",
    "productName": "UniGet",
    "copyright": "Copyright © 2024 UniGet Team",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "muhammeddolan-sketch",
      "repo": "yt-dlp-manager"
    },
    "files": [
      "**/*",
      "!dist",
      "!out",
      "!.git",
      "!.tmp",
      "!web-extension"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniGet",
      "uninstallDisplayName": "UniGet",
      "runAfterFinish": true
    }
  },
  "keywords": [],
  "author": "muhammeddolan-sketch",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  }
}
