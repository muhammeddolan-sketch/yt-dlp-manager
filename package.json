{
  "name": "yt-dlp-manager",
  "version": "1.5.1",
  "description": "Premium YT-DLP GUI Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.uniget.app",
    "productName": "UniGet",
    "copyright": "Copyright © 2024 UniGet Team",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "muhammeddolan-sketch",
      "repo": "yt-dlp-manager"
    },
    "files": [
      "**/*",
      "!dist",
      "!out",
      "!.git",
      "!web-extension"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniGet",
      "uninstallDisplayName": "UniGet",
      "runAfterFinish": true
    }
  },
  "keywords": [],
  "author": "muhammeddolan-sketch",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  }
}
